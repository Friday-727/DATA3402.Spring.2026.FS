   "source": [
    "#Part b --> using numpy to compute covariance matrix and correlation matrix between all observables (separate low and high level features)\n",
    "\n",
    "cov_low = np.cov(df_low, rowvar=False) #covariance measures the direction of a linear relationship between two variables (direction only)\n",
    "cov_high = np.cov(df_high, rowvar=False)\n",
    "\n",
    "corr_low = np.corrcoef(df_low.values, rowvar=False) #correlation measures the similarity (in terms of distance) between two variables (mag and direction)\n",
    "corr_high = np.corrcoef(df_high.values, rowvar=False)"
   ]
  },
