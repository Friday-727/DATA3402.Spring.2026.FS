    "import pandas as pd # I will be using pandas here to assist with adding an index, so it is easier to see which variables are being compared to others\n",
    "\n",
    "def display_matrix(matrix, var_names, title): #function takes arguments, matrix (square list of lists), var_names (to index), and title to display\n",
    "    n = matrix.shape[0]\n",
    "    df = pd.DataFrame(matrix, index=var_names, columns=var_names)\n",
    "    \n",
    "    print(title)\n",
    "    \n",
    "    display(df)"
   ]
